QDRANT_HOST=http://localhost:6333
QDRANT_TIMEOUT=60
COLLECTION_NAME=technical_docs
SEARXNG_HOST=http://localhost:8080
DENSE_DIM=1024
N_CTX=8192
N_THREADS=6
N_GPU_LAYERS=0
