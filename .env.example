DYNAMIC_WEIGHTS=false
DYNAMIC_STRENGTH=0.5
CORS_ORIGINS=https://ulucan.dev,http://localhost:3000,http://localhost:5173,http://localhost:8000,http://127.0.0.1:8000
DEVICE=auto
